# Copy to .env and fill in. .env is gitignored.

# --- Planner LLM (required) ---------------------------------------------
# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Reasoning model for the Investigation Planner. Needs to be capable —
# multi-step planning over graph state is where small models fall apart.
ACPIA_PLANNER_MODEL=llama-3.3-70b-versatile

# Cheap, fast model for per-file routing and short classification calls.
ACPIA_ROUTER_MODEL=llama-3.1-8b-instant

# --- Notification (day 7) -----------------------------------------------
# Escalation goes to YOUR OWN address and phone. Never a real third party.
ACPIA_ALERT_EMAIL=
ACPIA_ALERT_PHONE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Mock external registry (day 6) -------------------------------------
# Local stub standing in for a vehicle-registry lookup. Must never point at a
# real government service.
ACPIA_REGISTRY_URL=http://localhost:8099
